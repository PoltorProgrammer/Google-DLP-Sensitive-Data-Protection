# Shell scripts must stay LF or they break on macOS/Linux
*.sh       text eol=lf
*.command  text eol=lf

# Windows batch files need CRLF
*.bat      text eol=crlf

# Everything else: normalize to LF in the repo
*.py       text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
